{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(rm:*)",
      "Bash(cd:*)",
      "Bash(gh run watch*)",
      "Bash(*sleep*)",
      "mcp__jira__jira_get_user_profile",
      "mcp__jira__jira_search_fields",
      "mcp__jira__jira_get_project_issues",
      "mcp__jira__jira_get_transitions",
      "mcp__jira__jira_get_worklog",
      "mcp__jira__jira_download_attachments",
      "mcp__jira__jira_get_agile_boards",
      "mcp__jira__jira_get_board_issues",
      "mcp__jira__jira_get_sprints_from_board",
      "mcp__jira__jira_get_sprint_issues",
      "mcp__jira__jira_batch_create_issues",
      "mcp__jira__jira_delete_issue",
      "mcp__jira__jira_add_comment",
      "mcp__jira__jira_add_worklog",
      "mcp__jira__jira_link_to_epic",
      "mcp__jira__jira_create_issue_link",
      "mcp__jira__jira_remove_issue_link",
      "mcp__jira__jira_transition_issue",
      "mcp__jira__jira_create_sprint",
      "mcp__jira__jira_update_sprint",
      "mcp__jira__jira_get_project_versions",
      "mcp__jira__jira_get_all_projects",
      "mcp__jira__jira_create_version",
      "mcp__jira__jira_batch_create_versions",
      "mcp__confluence__confluence_get_comments",
      "mcp__confluence__confluence_get_labels",
      "mcp__confluence__confluence_add_label",
      "mcp__confluence__confluence_create_page",
      "mcp__confluence__confluence_update_page",
      "mcp__confluence__confluence_delete_page",
      "mcp__confluence__confluence_add_comment",
      "mcp__confluence__confluence_search_user",
      "mcp__playwright__browser_resize",
      "mcp__playwright__browser_console_messages",
      "mcp__playwright__browser_handle_dialog",
      "mcp__playwright__browser_file_upload",
      "mcp__playwright__browser_install",
      "mcp__playwright__browser_press_key",
      "mcp__playwright__browser_navigate_back",
      "mcp__playwright__browser_network_requests",
      "mcp__playwright__browser_run_code",
      "mcp__playwright__browser_drag",
      "mcp__playwright__browser_hover",
      "mcp__playwright__browser_select_option"
    ],
    "defaultMode": "dontAsk"
  },
  "model": "claude-haiku",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Abiding",
      "Bowling",
      "Sipping",
      "Rolling",
      "Striking",
      "Mixing",
      "Bathing",
      "Napping",
      "Opining",
      "Mellowing",
      "Chilling",
      "Vibing",
      "Taking it easy",
      "Lounging",
      "Drifting"
    ]
  },
  "autoUpdatesChannel": "latest",
  "skipDangerousModePermissionPrompt": true,
  "effortLevel": "low"
}
