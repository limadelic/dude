{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {},
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(mix credo)"
    ],
    "deny": [
      "AskUserQuestion",
      "NotebookEdit",
      "EnterWorktree",
      "ExitWorktree",
      "EnterPlanMode",
      "ExitPlanMode",
      "CronCreate",
      "CronDelete",
      "CronList",
      "ScheduleWakeup",
      "Bash(gh run watch*)",
      "Bash(rm *)",
      "Bash(sleep *)",
      "Bash(python*)",
      "mcp__*"
    ],
    "defaultMode": "dontAsk"
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "dude status_line",
    "padding": 0
  },
  "extraKnownMarketplaces": {},
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Abiding",
      "Bowling",
      "Sipping",
      "Rolling",
      "Striking",
      "Mixing",
      "Bathing",
      "Napping",
      "Opining",
      "Mellowing",
      "Chilling",
      "Vibing",
      "Taking it easy",
      "Lounging",
      "Drifting"
    ]
  },
  "effortLevel": "low",
  "autoCompactWindow": 200000,
  "autoUpdatesChannel": "stable",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "preferredNotifChannel": "notifications_disabled",
  "autoCompactEnabled": true
}
