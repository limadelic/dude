{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {},
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [],
    "deny": [
      "AskUserQuestion",
      "NotebookEdit",
      "EnterWorktree",
      "ExitWorktree",
      "EnterPlanMode",
      "ExitPlanMode",
      "CronCreate",
      "CronDelete",
      "CronList",
      "ScheduleWakeup",
      "Bash(rm *)",
      "mcp__*"
    ],
    "defaultMode": "dontAsk"
  },
  "model": "fable",
  "hooks": {},
  "statusLine": {
    "type": "command",
    "command": "/opt/homebrew/lib/ruby/gems/4.0.0/bin/dude status_line",
    "padding": 0
  },
  "extraKnownMarketplaces": {},
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Abiding",
      "Bowling",
      "Sipping",
      "Rolling",
      "Striking",
      "Mixing",
      "Bathing",
      "Napping",
      "Opining",
      "Mellowing",
      "Chilling",
      "Vibing",
      "Taking it easy",
      "Lounging",
      "Drifting"
    ]
  },
  "effortLevel": "medium",
  "autoCompactWindow": 200000,
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "preferredNotifChannel": "notifications_disabled",
  "autoCompactEnabled": true
}
