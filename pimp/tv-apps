#!/bin/zsh
set -e

source ~/.zshrc

APPS_DIR="$HOME/Applications"
REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
ICON_CACHE_DIR="$REPO_DIR/pimp/tv-icons"
mkdir -p "$APPS_DIR" "$ICON_CACHE_DIR"

capitalize() {
  local str="$1"
  echo "${(U)str[1]}${str[2,-1]}"
}

fetch_icon() {
  local site="$1" url="$2" source="$3"
  local cache_file="$ICON_CACHE_DIR/${site}.png"

  if [[ -f "$cache_file" ]]; then
    echo "$cache_file|$source"
    return 0
  fi

  local domain=$(echo "$url" | sed -E 's|https?://([^/]+).*|\1|')
  local html=""

  html=$(curl -s -m 3 "$url" 2>/dev/null | head -c 100000)

  local touch_icon=$(echo "$html" | grep -oE 'href="[^"]*apple-touch-icon[^"]*"' | head -1 | cut -d'"' -f2)
  if [[ -n "$touch_icon" ]]; then
    [[ "$touch_icon" != http* ]] && touch_icon="https://${domain}${touch_icon}"
    if curl -s -m 3 -o "$cache_file" "$touch_icon" 2>/dev/null && [[ -s "$cache_file" ]]; then
      echo "$cache_file|apple-touch-icon"
      return 0
    fi
    rm -f "$cache_file"
  fi

  if curl -s -m 3 -o "$cache_file" "https://${domain}/apple-touch-icon.png" 2>/dev/null && [[ -s "$cache_file" ]]; then
    echo "$cache_file|apple-touch-icon"
    return 0
  fi
  rm -f "$cache_file"

  if curl -s -m 3 -o "$cache_file" "https://www.google.com/s2/favicons?domain=${domain}&sz=256" 2>/dev/null && [[ -s "$cache_file" ]]; then
    echo "$cache_file|google-favicon"
    return 0
  fi
  rm -f "$cache_file"

  if curl -s -m 3 -o "$cache_file" "https://${domain}/favicon.ico" 2>/dev/null && [[ -s "$cache_file" ]]; then
    echo "$cache_file|favicon.ico"
    return 0
  fi
  rm -f "$cache_file"

  return 1
}

convert_to_icns() {
  local src="$1" dst="$2"
  local tmp_iconset="${dst%.icns}.iconset"

  mkdir -p "$tmp_iconset"

  for size in 16 32 128 256 512; do
    sips -z $size $size "$src" --out "$tmp_iconset/icon_${size}x${size}.png" >/dev/null 2>&1 || return 1
    sips -z $((size*2)) $((size*2)) "$src" --out "$tmp_iconset/icon_${size}x${size}@2x.png" >/dev/null 2>&1 || return 1
  done

  iconutil -c icns -o "$dst" "$tmp_iconset" >/dev/null 2>&1 || return 1
  rm -rf "$tmp_iconset"
  return 0
}

declare -a icon_results
for site in "${(k)TV_SITES[@]}"; do
  url="${TV_SITES[$site]}"
  app_name="$(capitalize "$site").app"
  app_path="$APPS_DIR/$app_name"
  bundle_id="com.dude.tv.${site}"

  mkdir -p "$app_path/Contents/MacOS" "$app_path/Contents/Resources"

  executable="$app_path/Contents/MacOS/$(capitalize "$site")"
  cat > "$executable" << EOF
#!/bin/bash
open -na "Google Chrome" --args --app="$url"
EOF
  chmod +x "$executable"

  icon_source="none"
  icon_file=""
  if result=$(fetch_icon "$site" "$url" 2>/dev/null); then
    icon_src="${result%%|*}"
    icon_method="${result##*|}"
    icns_path="$app_path/Contents/Resources/icon.icns"
    if convert_to_icns "$icon_src" "$icns_path" 2>/dev/null; then
      icon_source="$icon_method"
      icon_file="<key>CFBundleIconFile</key><string>icon</string>"
    fi
  fi
  icon_results+=("$site: $icon_source")

  plist="$app_path/Contents/Info.plist"
  cat > "$plist" << EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleExecutable</key>
  <string>$(capitalize "$site")</string>
  <key>CFBundleIdentifier</key>
  <string>$bundle_id</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>$(capitalize "$site")</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>1.0</string>
  <key>CFBundleVersion</key>
  <string>1</string>
  $icon_file
</dict>
</plist>
EOF

  touch "$app_path"
done

print "Generated TV apps in $APPS_DIR"
print "Icon sources:"
for result in $icon_results; do
  print "  $result"
done

mdimport "$APPS_DIR" 2>/dev/null || true
killall Dock 2>/dev/null || true
