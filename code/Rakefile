require 'rspec/core/rake_task'

RSpec::Core::RakeTask.new(:spec)

desc 'Build and install gem'
task :install do
  Dir.chdir(__dir__) do
    sh 'gem build dude.gemspec'
    sh "gem install --install-dir #{Gem.dir} --bindir #{Gem.bindir} dude-*.gem"
    sh 'rm dude-*.gem'
  end
end

desc 'Run cucumber features'
task :features do
  sh 'bundle exec cucumber --tags "not @wip"'
end

desc 'Run rubocop with auto-correct on lib'
task :cop do
  sh 'bundle exec rubocop -a lib/'
end

desc 'Verify installed binary works'
task :verify_install do
  output = `echo '{}' | #{File.join(Gem.bindir, 'dude')} status_line 2>&1`
  raise 'Install verification failed' unless output.include?('🧠')
end

desc 'Full check: rubocop → spec → install → features → verify'
task shipit: [:cop, :spec, :install, :features, :verify_install]

task default: :spec
